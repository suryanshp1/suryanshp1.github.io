---
const GITHUB_USERNAME = 'suryanshp1';
let html = "";
let totalContributions = "0";
let days = [];
let weeks = [];
let monthLabels = [];

try {
  const response = await fetch(`https://github.com/users/${GITHUB_USERNAME}/contributions`);
  html = await response.text();

  const totalMatch = html.match(/<h2[^>]*>\s*([\d,]+)\s*contributions/i);
  if (totalMatch) {
    totalContributions = totalMatch[1];
  }

  const regex = /data-date="([^"]+)"[^>]*data-level="([0-4])/g;
  let match;
  while ((match = regex.exec(html)) !== null) {
    days.push({
      date: match[1],
      level: parseInt(match[2], 10)
    });
  }

  days.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

  let currentWeek = [];
  for (const day of days) {
    currentWeek.push(day);
    if (new Date(day.date).getDay() === 6 || days.indexOf(day) === days.length - 1) {
      weeks.push(currentWeek);
      currentWeek = [];
    }
  }

  const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  let lastMonth = -1;
  
  weeks.forEach((week, index) => {
    if (week.length === 0) return;
    const month = parseInt(week[0].date.split('-')[1], 10) - 1;
    if (month !== lastMonth && index > 0) {
      monthLabels.push({ name: monthNames[month], colIndex: index });
      lastMonth = month;
    } else if (lastMonth === -1) {
      lastMonth = month;
    }
  });

} catch (error) {
  console.error("Error fetching GitHub contributions:", error);
}
---

<div class="github-activity">
  <div class="activity-header">
    <h3>GitHub Activity</h3>
  </div>
  
  <div class="activity-body">
    <div class="graph-scroll-container">
      <div class="graph-wrapper">
        <div class="months">
          {monthLabels.map(label => (
            <span class="month-label" style={`left: calc(${label.colIndex} * (11px + 3px));`}>
              {label.name}
            </span>
          ))}
        </div>
        
        <div class="weeks">
          {weeks.map(week => (
            <div class="week">
              {week.length < 7 && weeks.indexOf(week) === 0 ? 
                Array.from({ length: 7 - week.length }).map(() => <div class="day day-placeholder"></div>) 
              : null}
              {week.map(day => (
                <div class="day" data-level={day.level} title={`${day.date}: Level ${day.level}`}></div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    
    <div class="activity-footer">
      <div class="total-text">{totalContributions} contributions in the last year</div>
      <div class="legend">
        <span>Less</span>
        <div class="day" data-level="0"></div>
        <div class="day" data-level="1"></div>
        <div class="day" data-level="2"></div>
        <div class="day" data-level="3"></div>
        <div class="day" data-level="4"></div>
        <span>More</span>
      </div>
    </div>
  </div>
</div>

<style>
  .github-activity {
    margin: 40px 0;
    border: 1px dashed var(--line);
    border-radius: 6px;
    background: transparent;
    overflow: hidden;
  }
  
  .activity-header {
    padding: 16px 20px;
    border-bottom: 1px dashed var(--line);
  }
  
  .activity-header h3 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: 24px;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .activity-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .graph-scroll-container {
    overflow-x: auto;
    padding-bottom: 8px; /* space for scrollbar */
    /* Hide scrollbar for clean look, but keep functionality */
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  .graph-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .graph-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: max-content;
  }

  .months {
    position: relative;
    height: 14px;
    width: 100%;
  }

  .month-label {
    position: absolute;
    font-size: 11px;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
  }

  .weeks {
    display: flex;
    gap: 3px;
  }

  .week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .day {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  .day-placeholder {
    background: transparent !important;
    outline: none !important;
  }

  .activity-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .legend span {
    margin: 0 4px;
  }

  /* Monochrome Theme Mapping */
  :root {
    --gh-0: #1a1b1a;
    --gh-1: #363636;
    --gh-2: #555555;
    --gh-3: #888888;
    --gh-4: #eeeeee;
    --gh-outline: rgba(255, 255, 255, 0.04);
  }
  
  [data-theme="light"] {
    --gh-0: #e2e4e2;
    --gh-1: #c0c0c0;
    --gh-2: #999999;
    --gh-3: #555555;
    --gh-4: #111111;
    --gh-outline: rgba(0, 0, 0, 0.04);
  }

  .day[data-level="0"] { background: var(--gh-0); outline: 1px solid var(--gh-outline); outline-offset: -1px; }
  .day[data-level="1"] { background: var(--gh-1); outline: 1px solid var(--gh-outline); outline-offset: -1px; }
  .day[data-level="2"] { background: var(--gh-2); outline: 1px solid var(--gh-outline); outline-offset: -1px; }
  .day[data-level="3"] { background: var(--gh-3); outline: 1px solid var(--gh-outline); outline-offset: -1px; }
  .day[data-level="4"] { background: var(--gh-4); outline: 1px solid var(--gh-outline); outline-offset: -1px; }
</style>

---
import '../styles/global.css';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>500 — Server Error</title>
  <meta name="description" content="Internal Server Error." />
  <meta name="robots" content="noindex, follow" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="icon" type="image/png" href="/favicon-512.png?v=3" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0b0d0c" />
</head>
<body>
<header class="nav-shell"><nav class="nav inner" aria-label="Primary navigation">
  <a class="wordmark" href="/" aria-label="Suryansh Pandey, home">Suryansh<span>.</span></a>
  <div class="nav-links"><a href="/">Home</a><a href="/#work">Projects</a><a href="/#experience">Experience</a><a href="/#about">About</a></div>
  <button class="theme-toggle" type="button" aria-label="Switch to light theme"><svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg><svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
</nav></header>
<main id="top" class="inner grid-section" style="min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
  <p class="section-index" style="margin-bottom: 1rem;">Error 500</p>
  <h1 style="font-size: 3rem; margin-bottom: 1rem; color: var(--ink);">Internal Server Error</h1>
  <p style="color: var(--muted); max-width: 500px; margin-bottom: 2rem;">Something went wrong on our end. Please try again later.</p>
  {error instanceof Error ? <pre style="font-size: 0.8em; color: #ff6b6b; background: rgba(255, 107, 107, 0.1); padding: 1rem; border-radius: 4px; max-width: 100%; overflow: auto; text-align: left; margin-bottom: 2rem;">{error.message}</pre> : null}
  <a href="/" style="display: inline-flex; align-items: center; gap: 8px; color: var(--acid); font-weight: 500; text-decoration: none; border: 1px solid var(--line); padding: 12px 24px; border-radius: 4px; transition: all 0.2s;">Return Home <span style="font-size: 1.2em;">↗</span></a>
</main>
<footer class="footer inner" style="margin-top: auto;"><span>© 2026 Suryansh Pandey</span><span>Designed with intent. Built with Astro.</span></footer>
<script>
const root=document.documentElement,toggle=document.querySelector('.theme-toggle'),saved=localStorage.getItem('theme');if(saved)root.dataset.theme=saved;const clickAudio=new Audio('/click.mp3');toggle?.addEventListener('click',(e)=>{const next=root.dataset.theme==='dark'?'light':'dark';const icon=toggle.querySelector(root.dataset.theme==='dark'?'.icon-sun':'.icon-moon');const rect=(icon||toggle).getBoundingClientRect();const x=rect.left+rect.width/2,y=rect.top+rect.height/2;let style=document.getElementById('theme-ripple-style');if(!style){style=document.createElement('style');style.id='theme-ripple-style';document.head.appendChild(style);}style.textContent=`::view-transition-new(root){animation:theme-ripple-in 0.65s cubic-bezier(0.4, 0, 0.2, 1) both;}@keyframes theme-ripple-in{from{clip-path:circle(0% at ${x}px ${y}px)}to{clip-path:circle(150vmax at ${x}px ${y}px)}}`;const applyTheme=()=>{root.dataset.theme=next;localStorage.setItem('theme',next);toggle.setAttribute('aria-label',`Switch to ${next==='dark'?'light':'dark'} theme`);clickAudio.currentTime=0;clickAudio.play().catch(()=>{});};if(!document.startViewTransition){applyTheme();return;}document.startViewTransition(applyTheme);});
</script>
</body>
</html>
